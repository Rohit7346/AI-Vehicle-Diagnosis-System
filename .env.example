# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust variables to match your local setup
# ==============================================================================

# Backend API Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="AI Multimodal Vehicle Diagnosis System"
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML Inference Weights Paths (Relative to project root or absolute paths)
COMPONENT_MODEL_WEIGHTS=ml/weights/component_detector_best.pt
FAULT_MODEL_WEIGHTS=ml/weights/fault_detector_best.pt
DEVICE=cuda:0 # Options: "cuda:0", "cpu", "mps"
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# Storage Configuration
UPLOAD_DIR=temp/uploads
MAX_UPLOAD_SIZE_MB=25

# Future Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vehicle_diagnosis
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
